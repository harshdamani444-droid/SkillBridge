FLASK_ENV=development
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Database: Local SQLite or Cloud PostgreSQL (Neon / Supabase)
DATABASE_URL=sqlite:///skillbridge.db
# DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

JWT_SECRET_KEY=your-jwt-secret-key-change-me
SECRET_KEY=your-flask-secret-key-change-me

# Anthropic Claude 3.5 Sonnet for AI analysis (falls back to keyword matching if blank)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Gmail SMTP for OTP password reset emails
EMAIL_USER=
EMAIL_PASS=
